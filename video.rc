BEGIN
    BUTTON      ID_FILE_OPENPROJECT
    SEPARATOR
    BUTTON      ID_FILE_SAVEDATA
    BUTTON      ID_FILE_UPDATE
    BUTTON      IDD_SAVE_WMF
    SEPARATOR
    BUTTON      ID_RESIZE
    SEPARATOR
    BUTTON      ID_GRAPH_NEW
    BUTTON      ID_GRAPH_MODIFY
    BUTTON      ID_WINDOW_CLOSEALL
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open project...",            ID_FILE_OPENPROJECT
        MENUITEM "Load session",                ID_FILE_LOADSESSION
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About video...",             ID_APP_ABOUT
    END
END

IDR_VIDEO MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open project...",            ID_FILE_OPENPROJECT
        MENUITEM "Load Session",                ID_FILE_LOADSESSION
        MENUITEM "&Close project...",           ID_FILE_CLOSE
        MENUITEM "Close &All projects ",        ID_FILE_CLOSE_ALL
        MENUITEM SEPARATOR
        MENUITEM "Save &data...",               ID_FILE_SAVEDATA
        MENUITEM "Save session",                ID_FILE_SAVESESSION
        MENUITEM "Save &movie...",              ID_FILE_SAVEPICT
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Graph"
    BEGIN
        MENUITEM "&New...",                     ID_GRAPH_NEW
        MENUITEM "&Modify...",                  ID_GRAPH_MODIFY
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "Tile &horizontally",          ID_WINDOW_TILE_HORZ
        MENUITEM "Tile &vertically",            ID_WINDOW_TILE_VERT
        MENUITEM "Arrange &Icons",              ID_WINDOW_ARRANGE
        MENUITEM SEPARATOR
        MENUITEM "Close &All",                  ID_WINDOW_CLOSEALL
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About video...",             ID_APP_ABOUT
    END
END


